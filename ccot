#!/bin/sh
# Admin command line for the TEST site. Always uses the test data folder, never the live one.
here="$(cd "$(dirname "$0")" && pwd)"
py="$here/engine/.venv/bin/python"
if [ ! -x "$py" ]; then
  echo "engine/.venv is missing. Create it with:" >&2
  echo "  python3 -m venv \"$here/engine/.venv\" && \"$here/engine/.venv/bin/pip\" install -e \"$here/engine[test]\"" >&2
  exit 1
fi
export CCOT_DATA="${CCOT_TEST_DATA:-$HOME/Documents/CCOT Rota Testing Data}"
case "$CCOT_DATA" in
  *"/CCOT Rota Data"|*"/CCOT Rota Data/") echo "refusing: that is the LIVE data folder" >&2; exit 1 ;;
esac
exec "$py" -m ccot "$@"
